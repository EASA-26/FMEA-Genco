# FMEA Report Generator - local settings.
# Copy this file to .env (which is never committed) and adjust as needed.
# Real environment variables take precedence over values in .env.

# How users sign in:
#   local      - one username/password account (below); use this on your own computer.
#   databricks - identity comes from the Databricks Apps proxy (set in app.yaml only).
AUTH_MODE=local

# Sign-in account for AUTH_MODE=local.
ADMIN_USERNAME=admin
# scrypt hash of the password. Create one with:  python tools/hash_password.py
# When this line stays commented out, the built-in development password is used;
# always set your own hash before other people can reach the app.
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<key>

# Sign users out after this many minutes without activity.
SESSION_IDLE_MINUTES=60
# Most signed-in sessions kept in memory; the least recently used is dropped first.
MAX_SESSIONS=200
# Largest workbook accepted, in megabytes.
MAX_UPLOAD_MB=20

# Send the session cookie over HTTPS only. Keep false for http://127.0.0.1,
# set true whenever the app is served over HTTPS.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=fmea_session

# Network address and port. 127.0.0.1 keeps the app reachable from this computer only.
HOST=127.0.0.1
PORT=8000

# Server log detail: debug, info, warning or error.
LOG_LEVEL=info

# "Email the PDF" on the Export step opens a new email in classic Outlook on
# this computer, with the PDF attached; the user checks it and presses Send.
# Windows only, needs the Outlook desktop app.
#   auto - offered only when the app runs on this computer
#          (AUTH_MODE=local and HOST=127.0.0.1, localhost or ::1)
#   on   - always offered on Windows; Outlook opens on the computer running the server
#   off  - never offered
OUTLOOK_EMAIL=auto

# Tests only: path to a real FMEA workbook (read-only; tests skip when it is missing).
# FMEA_SAMPLE_WORKBOOK=C:/path/to/workbook.xlsx
